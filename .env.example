# Storefront environment (copy to .env.local for development, set in the host for production)

# Express backend public store API (without trailing slash). Empty = built-in demo data.
#   Production example: https://api.alaynaas.com/api/store
NEXT_PUBLIC_API_URL=

# Public address of THIS website, no trailing slash. Used for canonical URLs, hreflang,
# sitemap.xml, robots.txt and social share links. Must be the live domain in production.
#   Production example: https://www.alaynaas.com
NEXT_PUBLIC_SITE_URL=

# Optional fallback if the Instagram link is not set in Admin > Storefront > Contact
NEXT_PUBLIC_INSTAGRAM_URL=

# Where uploaded images (/uploads/*) are stored. Production: the Vercel Blob store's public URL
# (Vercel → Storage → your Blob store → "Base URL"), e.g. https://xxxx.public.blob.vercel-storage.com
# Leave empty locally (uses the Express server from NEXT_PUBLIC_API_URL).
UPLOADS_ORIGIN=
